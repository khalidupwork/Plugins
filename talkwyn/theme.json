			"radius": {
				"sm": "10px",
				"md": "16px",
				"lg": "24px",
				"xl": "32px",
				"pill": "999px",
				"bubble": "18px"
			},
			"motion": {
				"ease": "cubic-bezier(.2,.8,.2,1)",
				"duration": "200ms"
			},
			"measure": "68ch"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
