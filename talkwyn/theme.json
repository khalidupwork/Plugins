      "defaultPresets": false,
      "presets": [
        {
          "slug": "sm",
          "name": "Small",
          "shadow": "0 1px 2px rgba(30, 15, 44, .08), 0 1px 1px rgba(30, 15, 44, .04)"
        },
        {
          "slug": "lg",
          "name": "Large",
          "shadow": "0 18px 48px rgba(30, 15, 44, .18)"
        }
      ]
    },
    "custom": {
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "20px",
        "pill": "999px",
        "bubble": "18px"
      },
      "motion": {
        "ease": "cubic-bezier(.2,.8,.2,1)",
        "duration": "180ms"
      },
      "measure": "68ch"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--6)",
      "padding": {
        "left": "var(--wp--preset--spacing--6)",
        "right": "var(--wp--preset--spacing--6)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--tw-link)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "800",
          "lineHeight": "1.15",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-1)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-2)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-3)",
          "fontWeight": "700"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-4)",
          "fontWeight": "700"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--on-primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "fontSize": "1rem",
          "lineHeight": "1.2"
        },
        "border": {
          "radius": "999px",
          "width": "0"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--tw-primary-hover)"
          }
        },
        ":focus": {
          "outline": {
            "color": "var(--tw-focus)",
            "offset": "3px",
            "style": "solid",
            "width": "2px"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      }
    },
    "blocks": {
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "0.9375rem"
        },
        "color": {
          "background": "var(--wp--preset--color--panel)"
        },
        "border": {
          "radius": "12px"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--primary)",
            "width": "3px"
          }
        }
      },
